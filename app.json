{
  "expo": {
    "name": "pump",
    "slug": "pump",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "pump",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#282828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexisavnl.pump",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#282828"
      },
      "generateSplashScreens": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Pump utilise HealthKit pour lire vos données de santé et afficher vos statistiques d'entraînement.",
        "NSHealthUpdateUsageDescription": "Pump enregistre vos séances de musculation dans Apple Santé."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#282828"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.alexisavnl.pump"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
